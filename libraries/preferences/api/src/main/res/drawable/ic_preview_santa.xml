                android:fillColor="#FFE0BD"
                android:pathData="M24,27m-8,0a8,8 0,1,1 16,0a8,8 0,1,1 -16,0" />
            <!-- Eyes -->
            <path
                android:fillColor="#000000"
                android:pathData="M21,25m-1,0a1,1 0,1,1 2,0a1,1 0,1,1 -2,0M27,25m-1,0a1,1 0,1,1 2,0a1,1 0,1,1 -2,0" />
