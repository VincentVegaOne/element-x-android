                android:fillColor="#DC143C"
                android:pathData="M18,14L24,10L30,14L30,22L18,22Z" />
            <!-- Hat trim -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M17,21h14v2h-14z" />
